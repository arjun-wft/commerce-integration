# Copy this file to .env before running Docker Compose.
# Replace all example passwords/secrets. Use URL-safe characters in local passwords
# used inside MEDUSA_DATABASE_URL and MEDUSA_REDIS_URL.

# Integration API
PORT=3000
NODE_ENV=development

# Local PostgreSQL shared by the integration, Directus, and Medusa
POSTGRES_DB=commerce_integration
POSTGRES_USER=commerce
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_PORT=5432

# Integration's PostgreSQL connection (Compose overrides host/port/database)
AIVEN_HOST=postgres
AIVEN_PORT=5432
AIVEN_USER=commerce
AIVEN_PASSWORD=replace_with_local_postgres_password
AIVEN_DATABASE=commerce_integration
AIVEN_SSL=false
AIVEN_CA_PEM=
AIVEN_MAX_POOL=10

# Local Redis (Compose overrides host/port)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace_with_local_redis_password

# Provider API addresses as seen from the integration container
MEDUSA_BASE_URL=http://medusa:9000
MEDUSA_PUBLISHABLE_KEY=replace_with_medusa_publishable_key
MEDUSA_SECRET_KEY=replace_with_medusa_secret_key
MEDUSA_WEBHOOK_SECRET=replace_with_64_character_hex_secret

DIRECTUS_BASE_URL=http://directus:8055
DIRECTUS_TOKEN=replace_with_directus_static_token
DIRECTUS_WEBHOOK_SECRET=replace_with_directus_webhook_secret

# Optional Directus service (docker compose --profile cms up)
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_KEY=replace_with_long_random_directus_key
DIRECTUS_SECRET=replace_with_long_random_directus_secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace_with_directus_admin_password

# Optional Medusa service (docker compose --profile commerce up)
MEDUSA_PORT=9000
# Keep the password in these URLs aligned with POSTGRES_PASSWORD and REDIS_PASSWORD.
MEDUSA_DATABASE_URL=postgres://commerce:replace_with_local_postgres_password@postgres:5432/medusa
MEDUSA_REDIS_URL=redis://default:replace_with_local_redis_password@redis:6379
MEDUSA_STORE_CORS=http://localhost:8000
MEDUSA_ADMIN_CORS=http://localhost:9000
MEDUSA_AUTH_CORS=http://localhost:9000,http://localhost:8000
MEDUSA_JWT_SECRET=replace_with_long_random_jwt_secret
MEDUSA_COOKIE_SECRET=replace_with_long_random_cookie_secret
